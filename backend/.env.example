PORT=4000
NODE_ENV=development

# Local mongod: mongodb://127.0.0.1:27017/cochat
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/cochat?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cochat

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Comma-separated list of allowed web/app origins
CORS_ORIGINS=http://localhost:4200

# Public base URL used to build absolute links to uploaded files
PUBLIC_BASE_URL=http://localhost:4000

# Minutes of socket inactivity before a connected user is marked "away"
PRESENCE_AWAY_MINUTES=2

# Firebase service-account JSON (Project Settings -> Service Accounts ->
# Generate new private key), minified to a single line. Push notifications
# are silently disabled if this isn't set. Never commit the real value --
# this file is the .example; put the real one only in your local .env
# (gitignored) or in Render's dashboard as a secret env var.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", "...": "..."}
